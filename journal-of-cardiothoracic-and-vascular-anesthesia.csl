<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="sort-only" default-locale="en-US">
  <info>
    <title>Journal of Cardiothoracic and Vascular Anesthesia</title>
    <title-short>JCVA</title-short>
    <id>http://www.zotero.org/styles/journal-of-cardiothoracic-and-vascular-anesthesia</id>
    <link href="http://www.zotero.org/styles/journal-of-cardiothoracic-and-vascular-anesthesia" rel="self"/>
    <link href="https://www.jcvaonline.com/content/authorinfo#references-2-18-1" rel="documentation"/>
    <author>
      <name>JCVA Custom Style</name>
    </author>
    <category citation-format="numeric"/>
    <category field="medicine"/>
    <issn>1053-0770</issn>
    <updated>2024-01-01T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  
  <macro name="author">
    <names variable="author">
      <name initialize-with="." 
            delimiter=", "
            delimiter-precedes-last="always"/>
      <label form="short" prefix=" (" suffix=")"/>
      <substitute>
        <names variable="editor"/>
        <text variable="container-title"/>
      </substitute>
    </names>
  </macro>
  
  <macro name="editor">
    <names variable="editor">
      <name initialize-with="." 
            delimiter=", "
            delimiter-precedes-last="always"/>
      <label form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>
  
  <macro name="title">
    <text variable="title"/>
  </macro>
  
  <macro name="publisher">
    <group delimiter=", ">
      <text variable="publisher"/>
      <text variable="publisher-place"/>
    </group>
  </macro>
  
  <macro name="year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>
  
  <macro name="access-date">
    <group prefix="(accessed " suffix=")">
      <date variable="accessed" form="text"/>
    </group>
  </macro>
  
  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=",">
      <text variable="citation-number"/>
    </layout>
  </citation>
  
  <bibliography second-field-align="flush" entry-spacing="0">
    <layout suffix=".">
      <text variable="citation-number" prefix="[" suffix="] "/>
      
      <choose>
        <!-- Journal Article with article number (e.g., Heliyon) -->
        <if variable="article-number">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="year"/>
            <text macro="title"/>
            <group delimiter=". ">
              <group delimiter=" ">
                <text variable="container-title" form="short" strip-periods="false"/>
                <group delimiter=", ">
                  <text variable="volume"/>
                  <text variable="article-number"/>
                </group>
              </group>
              <text variable="DOI" prefix="https://doi.org/"/>
            </group>
          </group>
        </if>
        
        <!-- Standard Journal Article -->
        <else-if type="article-journal">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="title"/>
            <group delimiter=", ">
              <group delimiter=" ">
                <text variable="container-title" form="short" strip-periods="false"/>
                <group delimiter=" ">
                  <text variable="volume"/>
                  <group prefix="(" suffix=")" delimiter=" ">
                    <text macro="year"/>
                  </group>
                  <text variable="page"/>
                </group>
              </group>
              <text variable="DOI" prefix="https://doi.org/"/>
            </group>
          </group>
        </else-if>
        
        <!-- Book -->
        <else-if type="book">
          <group delimiter=", ">
            <text macro="author"/>
            <text macro="title"/>
            <text macro="publisher"/>
            <text macro="year"/>
          </group>
        </else-if>
        
        <!-- Book Chapter -->
        <else-if type="chapter">
          <group delimiter=", ">
            <text macro="author"/>
            <text macro="title"/>
            <group delimiter=": ">
              <text term="in"/>
              <text macro="editor"/>
            </group>
            <text variable="container-title"/>
            <text macro="publisher"/>
            <text macro="year"/>
            <group delimiter=" ">
              <label variable="page" form="short"/>
              <text variable="page"/>
            </group>
          </group>
        </else-if>
        
        <!-- Webpage/Website -->
        <else-if type="webpage post-weblog" match="any">
          <group delimiter=", ">
            <text macro="author"/>
            <text macro="title"/>
            <group delimiter=", ">
              <text variable="URL"/>
              <group delimiter=" ">
                <text macro="year"/>
                <text macro="access-date"/>
              </group>
            </group>
          </group>
        </else-if>
        
        <!-- Default -->
        <else>
          <group delimiter=", ">
            <text macro="author"/>
            <text macro="title"/>
            <text variable="container-title"/>
            <text macro="year"/>
            <choose>
              <if variable="URL">
                <group delimiter=", ">
                  <text variable="URL"/>
                  <group delimiter=" ">
                    <text macro="year"/>
                    <text macro="access-date"/>
                  </group>
                </group>
              </if>
            </choose>
          </group>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
